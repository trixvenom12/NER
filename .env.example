# ==========================================================
# NER Logistics Platform - Environment Configuration
# ==========================================================

# 1. Supabase PostgreSQL Database URI
# Located in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Recommendation for Vercel: Use the Connection Pooler URI (port 6543)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# 2. Supabase Project Credentials (Optional for client/SDK access)
# Located in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
